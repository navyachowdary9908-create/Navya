{
  "name": "ai-chatbot",
  "version": "1.0.0",
  "description": "AI chatbot built with TypeScript, Google Gemini API, and deployed on Vercel as serverless functions.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.client.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json --noEmit",
    "dev": "npm run build && vercel dev"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vercel/node": "^3.2.0",
    "typescript": "^5.5.0",
    "vercel": "^34.0.0"
  }
}